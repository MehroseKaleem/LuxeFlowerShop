# ==============================
# App
# ==============================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME="Luxeflower"
CLIENT_URL=https://luxefloweruae.com
ADMIN_CLIENT_URL=https://admin.luxefloweruae.com
CORS_ORIGINS=https://luxefloweruae.com,https://admin.luxefloweruae.com,http://localhost:3000,http://localhost:4200,http://localhost:4000

# ==============================
# Database (MariaDB via Prisma)
# ==============================
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://luxeflower_user:change_me@localhost:3306/luxeflower"

# ==============================
# JWT / Auth
# ==============================
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_string
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_COOKIE_NAME=luxeflower_refresh_token

# ==============================
# Bcrypt
# ==============================
BCRYPT_SALT_ROUNDS=12

# ==============================
# Uploads
# ==============================
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_BASE_URL=/uploads

# Optional — when all three are set, product/category/banner/avatar uploads
# go to Cloudinary (auto-optimized, CDN-served) instead of local disk. Get
# these from your Cloudinary dashboard after signing up at cloudinary.com —
# free tier is enough for this store. Leave blank to keep using local disk
# (fine for development, not recommended for production hosting).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================
# Stripe
# ==============================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=aed

# ==============================
# SMTP / Email
# ==============================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change_me
SMTP_PASSWORD=change_me
EMAIL_FROM_NAME="Luxeflower"
EMAIL_FROM_ADDRESS=no-reply@luxefloweruae.com

# ==============================
# Rate limiting
# ==============================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_GENERAL=300
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_ADMIN=600

# ==============================
# Seed (first Super Admin)
# ==============================
SEED_SUPER_ADMIN_NAME="Luxeflower Admin"
SEED_SUPER_ADMIN_EMAIL=admin@luxefloweruae.com
SEED_SUPER_ADMIN_PHONE=+971500000000
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@12345
